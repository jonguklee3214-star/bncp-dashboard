# ─────────────────────────────────────────────────────────────
#  BNCP Fuel Tracking — 환경변수 예시
#  이 파일(.env.example)은 커밋해도 됩니다. 실제 값은 .env.local 에 넣으세요.
#  .env.local 은 절대 GitHub 에 올라가지 않습니다 (.gitignore 처리됨).
# ─────────────────────────────────────────────────────────────

# Google Sheet ID (주소창 .../spreadsheets/d/<이 부분>/edit)
GOOGLE_SHEET_ID=1x78ssL_Ux3B2-lydHXbkW4bDGvGs1e1ssMzHDTWhr4o

# Service Account 이메일 (JSON 의 client_email)
GOOGLE_SERVICE_ACCOUNT_EMAIL=xxxxx@yyyyy.iam.gserviceaccount.com

# Service Account private key (JSON 의 private_key).
# 줄바꿈은 \n 으로 넣거나, 따옴표로 감싼 여러 줄 그대로 붙여넣어도 됩니다.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n....\n-----END PRIVATE KEY-----\n"

# ── 현장 위치 (날씨 · 타임존) ──
WEATHER_LOCATION_NAME=Baghdad
WEATHER_LATITUDE=33.3152
WEATHER_LONGITUDE=44.3661
SITE_TIMEZONE=Asia/Baghdad
